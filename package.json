{
	"name": "@projectwallace/format-css",
	"version": "3.2.1",
	"description": "Fast, small, zero-config library to format or minify CSS with basic rules.",
	"keywords": [
		"css",
		"format",
		"formatter",
		"prettier",
		"prettifier",
		"pretty",
		"print",
		"style",
		"stylesheet"
	],
	"homepage": "https://github.com/projectwallace/format-css",
	"license": "MIT",
	"author": "Bart Veneman <bart@projectwallace.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/projectwallace/format-css.git"
	},
	"bin": {
		"format-css": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"types": "./dist/index.d.ts",
		"default": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest --coverage",
		"check": "tsc",
		"lint": "oxlint && oxfmt --check",
		"knip": "knip"
	},
	"dependencies": {
		"@projectwallace/css-parser": "https://pkg.pr.new/@projectwallace/css-parser@3150999"
	},
	"devDependencies": {
		"@projectwallace/preset-oxlint": "^0.0.11",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.4",
		"knip": "^6.41.0",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.87.0",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"engines": {
		"node": ">=20.12.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@11.16.0",
	"issues": "https://github.com/projectwallace/format-css/issues"
}
